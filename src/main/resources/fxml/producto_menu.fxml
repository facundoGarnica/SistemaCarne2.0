<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1200.0" styleClass="pm-root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Producto_menuController">
    <stylesheets>
        <URL value="@../styles/gestion_productos.css" />
    </stylesheets>

    <VBox spacing="18.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="22.0" />
        </padding>

        <!-- Encabezado -->
        <VBox spacing="2.0">
            <Label styleClass="pm-title" text="Productos" />
            <Label styleClass="pm-subtitle" text="Agregá, editá o eliminá productos del catálogo" />
        </VBox>

        <!-- Tarjetas de estadísticas -->
        <HBox spacing="14.0">
            <VBox spacing="4.0" styleClass="pm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label styleClass="pm-stat-label" text="Productos" />
                <Label fx:id="labelTotalProductos" styleClass="pm-stat-value" text="0" />
            </VBox>
            <VBox spacing="4.0" styleClass="pm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label styleClass="pm-stat-label" text="Categorías" />
                <Label fx:id="labelCategorias" styleClass="pm-stat-value" text="0" />
            </VBox>
            <VBox spacing="4.0" styleClass="pm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label styleClass="pm-stat-label" text="Precio promedio" />
                <Label fx:id="labelPrecioPromedio" styleClass="pm-stat-value" text="\$0" />
            </VBox>
            <VBox spacing="4.0" styleClass="pm-stat-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                <Label styleClass="pm-stat-label" text="Precio más alto" />
                <Label fx:id="labelPrecioMax" styleClass="pm-stat-value" text="\$0" />
            </VBox>
        </HBox>

        <!-- Barra de búsqueda y acciones -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <StackPane alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" maxWidth="460.0" prefWidth="460.0">
                <TextField fx:id="searchField" promptText="Buscar por nombre, código o categoría" styleClass="pm-search-field" maxWidth="Infinity" />
                <SVGPath content="M10 2a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.41-5.4-5.39A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" mouseTransparent="true" scaleX="0.75" scaleY="0.75" styleClass="pm-search-icon">
                    <StackPane.margin>
                        <Insets left="12.0" />
                    </StackPane.margin>
                </SVGPath>
            </StackPane>
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="-Infinity" fx:id="btnEditar" disable="true" onAction="#editarProducto" styleClass="pm-btn-outline" text="Editar">
                <graphic>
                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" scaleX="0.7" scaleY="0.7" styleClass="pm-icon" />
                </graphic>
            </Button>
            <Button minWidth="-Infinity" fx:id="btnEliminar" disable="true" onAction="#eliminarSeleccionado" styleClass="pm-btn-outline-danger" text="Eliminar">
                <graphic>
                    <SVGPath content="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zM7 6h10v13H7V6zm2 2v9h2V8H9zm4 0v9h2V8h-2z" scaleX="0.7" scaleY="0.7" styleClass="pm-icon" />
                </graphic>
            </Button>
            <Button minWidth="-Infinity" fx:id="btnAgregar" onAction="#setRutaProducto" styleClass="pm-btn" text="Nuevo">
                <graphic>
                    <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.8" scaleY="0.8" styleClass="pm-icon" />
                </graphic>
            </Button>
        </HBox>

        <!-- Tabla -->
        <TableView fx:id="tablaProductos" styleClass="pm-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="110.0" styleClass="pm-col-muted" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="420.0" text="Nombre" />
                <TableColumn fx:id="colPrecio" prefWidth="180.0" styleClass="pm-col-right" text="Precio" />
                <TableColumn fx:id="colCategoria" prefWidth="240.0" styleClass="pm-col-muted" text="Categoría" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label styleClass="pm-table-placeholder" text="No se encontraron productos" />
            </placeholder>
        </TableView>

        <Label fx:id="labelContador" styleClass="pm-counter-label" text="Mostrando 0 productos" />
    </VBox>

    <AnchorPane fx:id="difuminar" disable="true" prefHeight="200.0" prefWidth="200.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <AnchorPane fx:id="overlayCrearProducto" layoutX="93.0" layoutY="59.0" prefHeight="575.0" prefWidth="1014.0" AnchorPane.bottomAnchor="59.0" AnchorPane.leftAnchor="93.0" AnchorPane.rightAnchor="93.0" AnchorPane.topAnchor="59.0" />
        </children>
    </AnchorPane>
</AnchorPane>
