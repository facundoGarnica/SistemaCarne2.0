<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<TabPane prefHeight="650.0" prefWidth="1000.0" styleClass="ps-tabs" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GastosController">
    <stylesheets>
        <URL value="@../styles/empleadoYGastos.css" />
        <URL value="@../styles/personal.css" />
    </stylesheets>

    <tabs>
        <Tab closable="false" text="Gastos y compras">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <fx:define>
                    <ToggleGroup fx:id="grupoPeriodoGastos" />
                </fx:define>

                <!-- Encabezado -->
                <VBox spacing="2.0">
                    <Label styleClass="ps-title" text="Gastos" />
                    <Label styleClass="ps-subtitle" text="Registrá compras de mercadería, servicios y otros pagos" />
                </VBox>

                <!-- Formulario de alta / edición -->
                <HBox alignment="BOTTOM_LEFT" spacing="14.0" styleClass="ps-card">
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Fecha" />
                        <DatePicker fx:id="dpFechaGasto" minWidth="-Infinity" prefWidth="175.0" styleClass="ps-date" />
                    </VBox>
                    <VBox minWidth="160.0" spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-field-label" text="Descripción" />
                        <TextField fx:id="txtDescripcionGasto" maxWidth="Infinity" promptText="Ej: Pollo, Luz, Carbón" styleClass="ps-input" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Categoría" />
                        <ComboBox fx:id="cbCategoriaGasto" prefWidth="170.0" styleClass="ps-combo" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Medio de pago" />
                        <ComboBox fx:id="cbMedioPagoGasto" prefWidth="170.0" styleClass="ps-combo" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Monto" />
                        <TextField fx:id="txtMontoGasto" prefWidth="150.0" promptText="\$ 0" styleClass="ps-input" />
                    </VBox>
                    <Button minWidth="-Infinity" fx:id="btnGuardarGasto" onAction="#guardarGasto" styleClass="ps-btn" text="Guardar" />
                    <Button minWidth="-Infinity" fx:id="btnCancelarGasto" managed="false" onAction="#cancelarEdicionGasto" styleClass="ps-btn-outline, ps-btn-tall" text="Cancelar" visible="false" />
                </HBox>

                <!-- Período, categoría y acciones -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarGastosDeHoy" styleClass="ps-pill" text="Hoy" toggleGroup="$grupoPeriodoGastos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarSemanalGastos" selected="true" styleClass="ps-pill" text="Esta semana" toggleGroup="$grupoPeriodoGastos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarGastosDelMes" styleClass="ps-pill" text="Este mes" toggleGroup="$grupoPeriodoGastos" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglGastosRango" onAction="#mostrarSelectorRangoGastos" styleClass="ps-pill" text="Rango…" toggleGroup="$grupoPeriodoGastos">
                        <graphic>
                            <SVGPath content="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 10v10h14V10H5zm0-4v2h14V6H5z" scaleX="0.65" scaleY="0.65" styleClass="ps-icon" />
                        </graphic>
                    </ToggleButton>

                    <HBox fx:id="boxRangoGastos" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                        <DatePicker fx:id="dpDesdeGasto" prefWidth="150.0" promptText="Desde" styleClass="ps-date" />
                        <Label styleClass="ps-muted" text="a" />
                        <DatePicker fx:id="dpHastaGasto" prefWidth="150.0" promptText="Hasta" styleClass="ps-date" />
                        <Button minWidth="-Infinity" onAction="#filtrarGastos" styleClass="ps-btn-dark" text="Aplicar" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />
                    <Button minWidth="-Infinity" fx:id="btnBorrarGasto" disable="true" onAction="#borrarGasto" styleClass="ps-btn-outline-danger" text="Eliminar">
                        <graphic>
                            <SVGPath content="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zM7 6h10v13H7V6zm2 2v9h2V8H9zm4 0v9h2V8h-2z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <ComboBox fx:id="cbFiltroCategoriaGasto" prefWidth="210.0" styleClass="ps-combo, ps-combo-pill" />
                </HBox>

                <!-- Totales -->
                <HBox styleClass="ps-stats">
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Total gastado" />
                        <Label fx:id="lblTotalGastado" styleClass="ps-stat-value-lg" text="\$0" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="En efectivo" />
                        <Label fx:id="lblGastadoEfectivo" styleClass="ps-stat-value" text="\$0" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Virtual" />
                        <Label fx:id="lblGastadoVirtual" styleClass="ps-stat-value" text="\$0" />
                    </VBox>
                </HBox>

                <!-- Tabla de gastos -->
                <TableView fx:id="tvGastos" styleClass="ps-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGastoFecha" prefWidth="110" styleClass="ps-col-muted" text="Fecha" />
                        <TableColumn fx:id="colGastoDesc" prefWidth="320" text="Descripción" />
                        <TableColumn fx:id="colGastoCategoria" prefWidth="190" text="Categoría" />
                        <TableColumn fx:id="colGastoMedioPago" prefWidth="170" styleClass="ps-col-muted" text="Pago" />
                        <TableColumn fx:id="colGastoMonto" prefWidth="160" styleClass="ps-col-right" text="Importe" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder><Label styleClass="ps-placeholder" text="No hay gastos en este período" /></placeholder>
                </TableView>
            </VBox>
        </Tab>

        <Tab closable="false" text="Reportes y balance">
            <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="ps-items-scroll">
            <VBox spacing="14.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <!-- Encabezado con navegación de semanas -->
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <Button minWidth="-Infinity" onAction="#semanaAnteriorBalance" styleClass="ps-btn-outline, ps-btn-square">
                        <graphic>
                            <SVGPath content="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <VBox spacing="2.0">
                        <Label styleClass="ps-title" text="Balance" />
                        <Label fx:id="lblSemanaDias" styleClass="ps-subtitle" text="Semana" />
                    </VBox>
                    <Button minWidth="-Infinity" fx:id="btnSemanaSiguienteBalance" onAction="#semanaSiguienteBalance" styleClass="ps-btn-outline, ps-btn-square">
                        <graphic>
                            <SVGPath content="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Búsqueda por período o por un día puntual -->
                    <Label styleClass="ps-field-label" text="Desde" />
                    <DatePicker fx:id="dpDesdeBalance" prefWidth="150.0" styleClass="ps-date" />
                    <Label styleClass="ps-field-label" text="Hasta" />
                    <DatePicker fx:id="dpHastaBalance" prefWidth="150.0" styleClass="ps-date" />
                    <Button minWidth="-Infinity" onAction="#buscarRangoBalance" styleClass="ps-btn-dark, ps-btn-tall" text="Buscar" />
                    <Region minWidth="6.0" />
                    <Button minWidth="-Infinity" onAction="#imprimirResumenReporte" styleClass="ps-btn-outline, ps-btn-tall" text="Imprimir">
                        <graphic>
                            <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.72" scaleY="0.72" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Días de la semana: se pueden marcar varios y el balance suma los días elegidos -->
                <HBox fx:id="boxDiasBalance" spacing="12.0">
                    <ToggleButton fx:id="tbLunes" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbMartes" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbMiercoles" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbJueves" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbViernes" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbSabado" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                    <ToggleButton fx:id="tbDomingo" maxWidth="Infinity" onAction="#filtrarPorDias" styleClass="ps-dia" HBox.hgrow="ALWAYS" />
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <Label fx:id="lblMostrandoDias" styleClass="ps-counter" text="Mostrando: toda la semana" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink fx:id="lnkTodaLaSemana" onAction="#calcularBalance" styleClass="ps-link" text="Toda la semana" />
                </HBox>

                <!-- Tabla de balance -->
                <GridPane styleClass="ps-balance">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="130.0" percentWidth="16.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="130.0" percentWidth="16.0" />
                        <ColumnConstraints halignment="RIGHT" minWidth="130.0" percentWidth="16.0" />
                    </columnConstraints>

                    <!-- Encabezado -->
                    <Label maxWidth="Infinity" styleClass="ps-bal-head, ps-bal-first" text="Concepto" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-head" text="Efectivo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                    <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-head" text="Virtual" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <Label alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-head, ps-bal-last" text="Total" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <!-- Ingresos -->
                    <Label maxWidth="Infinity" styleClass="ps-bal-section, ps-bal-first" text="Ingresos" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="1" />
                    <Label maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-first" text="Ventas" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblBalVentasEf" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label fx:id="lblBalVentasVi" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <Label fx:id="lblBalVentasTot" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                    <!-- Ventas por turno (mismo horario que el ticket de cierre) -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="ps-bal-cell, ps-bal-sub, ps-bal-first" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label minWidth="-Infinity" styleClass="ps-bal-text-sub" text="Ventas de mañana" />
                        <Label minWidth="-Infinity" styleClass="ps-bal-nota" text="08:30 a 13:00" />
                        <Region HBox.hgrow="ALWAYS" />
                        <!-- Control de caja del turno (lo arma el controlador) -->
                        <HBox fx:id="boxArqueoManiana" alignment="CENTER_RIGHT" spacing="10.0" />
                    </HBox>
                    <Label fx:id="lblBalManianaEf" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                    <Label fx:id="lblBalManianaVi" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                    <Label fx:id="lblBalManianaTot" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="ps-bal-cell, ps-bal-sub, ps-bal-first" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <Label minWidth="-Infinity" styleClass="ps-bal-text-sub" text="Ventas de tarde" />
                        <Label minWidth="-Infinity" styleClass="ps-bal-nota" text="17:00 a 21:00" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="boxArqueoTarde" alignment="CENTER_RIGHT" spacing="10.0" />
                    </HBox>
                    <Label fx:id="lblBalTardeEf" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    <Label fx:id="lblBalTardeVi" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                    <Label fx:id="lblBalTardeTot" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-sub, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                    <!-- Egresos -->
                    <Label maxWidth="Infinity" styleClass="ps-bal-section, ps-bal-first" text="Egresos" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="5" />

                    <Label maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-first" text="Gastos" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                    <Label fx:id="lblBalGastosEf" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    <Label fx:id="lblBalGastosVi" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                    <Label fx:id="lblBalGastosTot" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="6" />

                    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="ps-bal-cell, ps-bal-first" GridPane.columnIndex="0" GridPane.rowIndex="7">
                        <Label styleClass="ps-bal-text" text="Sueldos" />
                        <Label fx:id="lblSueldosNota" styleClass="ps-bal-nota" text="se pagan el sábado" />
                    </HBox>
                    <Label fx:id="lblBalSueldosEf" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                    <Label fx:id="lblBalSueldosVi" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                    <Label fx:id="lblBalSueldosTot" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="7" />

                    <Label maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-first" text="Adelantos" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                    <Label fx:id="lblBalAdelEf" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                    <Label fx:id="lblBalAdelVi" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg" GridPane.columnIndex="2" GridPane.rowIndex="8" />
                    <Label fx:id="lblBalAdelTot" alignment="CENTER_RIGHT" maxWidth="Infinity" styleClass="ps-bal-cell, ps-bal-neg, ps-bal-last" GridPane.columnIndex="3" GridPane.rowIndex="8" />

                    <!-- Resultado -->
                    <VBox alignment="CENTER_LEFT" spacing="2.0" styleClass="ps-bal-res, ps-bal-first, ps-bal-res-left" GridPane.columnIndex="0" GridPane.rowIndex="9">
                        <Label styleClass="ps-bal-res-titulo" text="Resultado" />
                        <Label styleClass="ps-bal-nota" text="Lo que queda en caja" />
                    </VBox>
                    <Label fx:id="lblBalResEf" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-res, ps-bal-res-monto" GridPane.columnIndex="1" GridPane.rowIndex="9" />
                    <Label fx:id="lblBalResVi" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-res, ps-bal-res-monto" GridPane.columnIndex="2" GridPane.rowIndex="9" />
                    <Label fx:id="lblBalResTot" alignment="CENTER_RIGHT" maxHeight="Infinity" maxWidth="Infinity" styleClass="ps-bal-res, ps-bal-res-total, ps-bal-last, ps-bal-res-right" GridPane.columnIndex="3" GridPane.rowIndex="9" />
                </GridPane>

                <!-- Control de caja: billetes contados contra el sistema, en el período mostrado -->
                <VBox fx:id="boxControlCaja" managed="false" spacing="10.0" styleClass="ps-card" visible="false">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0">
                            <Label styleClass="ps-section-title" text="Control de caja" />
                            <Label styleClass="ps-bal-nota" text="Billetes contados contra el efectivo del sistema" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_RIGHT" spacing="2.0">
                            <Label fx:id="lblControlCajaTitulo" styleClass="ps-bal-nota" text="Diferencia" />
                            <Label fx:id="lblControlCajaTotal" styleClass="ps-arqueo-total" text="" />
                        </VBox>
                    </HBox>
                    <VBox fx:id="boxControlCajaDetalle" spacing="4.0" />
                </VBox>
            </VBox>
            </ScrollPane>
        </Tab>

        <Tab closable="false" text="Reportes de productos">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <fx:define>
                    <ToggleGroup fx:id="grupoPeriodoProductos" />
                </fx:define>

                <!-- Encabezado -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2.0">
                        <Label styleClass="ps-title" text="Productos vendidos" />
                        <Label styleClass="ps-subtitle" text="Qué se vende más, por categoría y por producto" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Solo la categoría elegida en la lista de la izquierda -->
                    <Button fx:id="btnImprimirCategoria" disable="true" minWidth="-Infinity" onAction="#imprimirCategoriaProductos" styleClass="ps-btn-outline, ps-btn-tall" text="Imprimir categoría">
                        <graphic>
                            <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.72" scaleY="0.72" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Region minWidth="8.0" />
                    <Button minWidth="-Infinity" onAction="#imprimirReporteProductos" styleClass="ps-btn-outline, ps-btn-tall" text="Imprimir todo">
                        <graphic>
                            <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.72" scaleY="0.72" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Período -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarProductosDeHoy" styleClass="ps-pill" text="Hoy" toggleGroup="$grupoPeriodoProductos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarReporteSemanalProductos" selected="true" styleClass="ps-pill" text="Esta semana" toggleGroup="$grupoPeriodoProductos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarProductosDelMes" styleClass="ps-pill" text="Este mes" toggleGroup="$grupoPeriodoProductos" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglProductosRango" onAction="#mostrarSelectorRangoProductos" styleClass="ps-pill" text="Rango…" toggleGroup="$grupoPeriodoProductos">
                        <graphic>
                            <SVGPath content="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 10v10h14V10H5zm0-4v2h14V6H5z" scaleX="0.65" scaleY="0.65" styleClass="ps-icon" />
                        </graphic>
                    </ToggleButton>
                    <HBox fx:id="boxRangoProductos" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                        <DatePicker fx:id="dpInicioProductos" prefWidth="150.0" promptText="Desde" styleClass="ps-date" />
                        <Label styleClass="ps-muted" text="a" />
                        <DatePicker fx:id="dpFinProductos" prefWidth="150.0" promptText="Hasta" styleClass="ps-date" />
                        <Button minWidth="-Infinity" onAction="#generarReporteProductos" styleClass="ps-btn-dark" text="Aplicar" />
                    </HBox>
                </HBox>

                <!-- Totales -->
                <HBox styleClass="ps-stats">
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Facturado" />
                        <Label fx:id="lblTotalFacturadoProductos" styleClass="ps-stat-value-lg" text="\$0" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Kilos vendidos" />
                        <Label fx:id="lblTotalKilosProductos" styleClass="ps-stat-value" text="0 kg" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Categoría líder" />
                        <Label fx:id="lblCategoriaTop" styleClass="ps-stat-value" text="—" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Más vendido" />
                        <Label fx:id="lblProductoTop" styleClass="ps-stat-value" text="—" />
                    </VBox>
                </HBox>

                <!-- Categorías + productos -->
                <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                    <VBox minWidth="300.0" prefWidth="380.0" styleClass="ps-panel">
                        <Label maxWidth="Infinity" styleClass="ps-panel-head" text="Categorías · tocá una para filtrar" />
                        <ListView fx:id="lvCategoriasProductos" styleClass="ps-cat-list" VBox.vgrow="ALWAYS">
                            <placeholder><Label styleClass="ps-placeholder" text="No hay ventas en el período" /></placeholder>
                        </ListView>
                    </VBox>

                    <VBox styleClass="ps-panel" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" styleClass="ps-panel-titlebar">
                            <Label fx:id="lblTituloDetalleProductos" styleClass="ps-section-title" text="Todos los productos" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblResumenDetalleProductos" styleClass="ps-detail-sub" text="" />
                        </HBox>
                        <TableView fx:id="tvReporteProductos" styleClass="ps-table, ps-table-flat" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRPPosicion" maxWidth="70.0" minWidth="50.0" prefWidth="60.0" sortable="false" styleClass="ps-col-muted" text="#" />
                                <TableColumn fx:id="colRPNombre" prefWidth="320" text="Producto" />
                                <TableColumn fx:id="colRPKilos" prefWidth="120" styleClass="ps-col-right" text="Kilos" />
                                <TableColumn fx:id="colRPPrecio" prefWidth="140" styleClass="ps-col-right, ps-col-muted" text="Precio prom." />
                                <TableColumn fx:id="colRPTotal" prefWidth="140" styleClass="ps-col-right" text="Total" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <placeholder><Label styleClass="ps-placeholder" text="No hay productos vendidos en el período" /></placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>
    </tabs>
</TabPane>
