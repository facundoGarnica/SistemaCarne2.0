<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<TabPane prefHeight="650.0" prefWidth="1000.0" styleClass="ps-tabs" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PersonalController">
    <stylesheets>
        <URL value="@../styles/empleadoYGastos.css" />
        <URL value="@../styles/personal.css" />
    </stylesheets>

    <tabs>
        <Tab closable="false" text="Turnos">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <fx:define>
                    <ToggleGroup fx:id="grupoPeriodoTurnos" />
                </fx:define>

                <!-- Encabezado -->
                <VBox spacing="2.0">
                    <Label styleClass="ps-title" text="Turnos" />
                    <Label styleClass="ps-subtitle" text="Registrá los turnos trabajados por cada empleado" />
                </VBox>

                <!-- Formulario de registro -->
                <HBox alignment="BOTTOM_LEFT" spacing="14.0" styleClass="ps-card">
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Fecha" />
                        <DatePicker fx:id="dpFechaTurno" prefWidth="170.0" styleClass="ps-date" />
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-field-label" text="Empleado" />
                        <ComboBox fx:id="cbEmpleado" maxWidth="Infinity" promptText="Elegir empleado" styleClass="ps-combo" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Turno" />
                        <ComboBox fx:id="cbTurno" prefWidth="170.0" promptText="Elegir turno" styleClass="ps-combo" />
                    </VBox>
                    <Button minWidth="-Infinity" onAction="#guardarTurno" styleClass="ps-btn" text="Registrar">
                        <graphic>
                            <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.8" scaleY="0.8" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Período + acciones -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <ToggleButton minWidth="-Infinity" fx:id="tglTurnosHoy" onAction="#mostrarTurnosDeHoy" styleClass="ps-pill" text="Hoy" toggleGroup="$grupoPeriodoTurnos" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglTurnosSemana" onAction="#mostrarSemanalTurnos" selected="true" styleClass="ps-pill" text="Esta semana" toggleGroup="$grupoPeriodoTurnos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarTurnosSemanaPasada" styleClass="ps-pill" text="Semana pasada" toggleGroup="$grupoPeriodoTurnos" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglTurnosRango" onAction="#mostrarSelectorRangoTurnos" styleClass="ps-pill" text="Rango…" toggleGroup="$grupoPeriodoTurnos">
                        <graphic>
                            <SVGPath content="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 10v10h14V10H5zm0-4v2h14V6H5z" scaleX="0.65" scaleY="0.65" styleClass="ps-icon" />
                        </graphic>
                    </ToggleButton>

                    <!-- Selector de rango: visible solo con "Rango…" activo -->
                    <HBox fx:id="boxRangoTurnos" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                        <DatePicker fx:id="dpDesdeTurno" prefWidth="150.0" promptText="Desde" styleClass="ps-date" />
                        <Label styleClass="ps-muted" text="a" />
                        <DatePicker fx:id="dpHastaTurno" prefWidth="150.0" promptText="Hasta" styleClass="ps-date" />
                        <Button minWidth="-Infinity" onAction="#filtrarTurnos" styleClass="ps-btn-dark" text="Aplicar" />
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblContadorTurnos" styleClass="ps-counter" text="0 turnos" />
                    <Button minWidth="-Infinity" onAction="#actualizarTodo" styleClass="ps-btn-outline" text="Ver todo" />
                    <Button minWidth="-Infinity" fx:id="btnBorrarTurno" disable="true" onAction="#borrarTurno" styleClass="ps-btn-outline-danger" text="Eliminar">
                        <graphic>
                            <SVGPath content="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zM7 6h10v13H7V6zm2 2v9h2V8H9zm4 0v9h2V8h-2z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Tabla de turnos -->
                <TableView fx:id="tvTurnos" styleClass="ps-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTurnoFecha" prefWidth="130" styleClass="ps-col-muted" text="Fecha" />
                        <TableColumn fx:id="colTurnoEmpleado" prefWidth="360" text="Empleado" />
                        <TableColumn fx:id="colTurnoTipo" prefWidth="220" sortable="false" text="Turno" />
                        <TableColumn fx:id="colTurnoMonto" prefWidth="160" styleClass="ps-col-right" text="Monto" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder><Label styleClass="ps-placeholder" text="No hay turnos registrados en este período" /></placeholder>
                </TableView>
            </VBox>
        </Tab>

        <Tab closable="false" text="Personal">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <!-- Encabezado -->
                <VBox spacing="2.0">
                    <Label styleClass="ps-title" text="Empleados" />
                    <Label styleClass="ps-subtitle" text="Agregá, editá o dá de baja empleados y administrá sus tokens" />
                </VBox>

                <!-- Formulario de alta / edición -->
                <HBox alignment="BOTTOM_LEFT" spacing="14.0" styleClass="ps-card">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-field-label" text="Nombre completo" />
                        <TextField fx:id="txtNombreEmpleado" maxWidth="Infinity" promptText="Ej: Lucía Gómez" styleClass="ps-input" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Sueldo mañana" />
                        <TextField fx:id="txtPagoManiana" prefWidth="150.0" promptText="\$0" styleClass="ps-input" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Sueldo tarde" />
                        <TextField fx:id="txtPagoTarde" prefWidth="150.0" promptText="\$0" styleClass="ps-input" />
                    </VBox>
                    <VBox spacing="6.0">
                        <Label styleClass="ps-field-label" text="Medio de pago" />
                        <ComboBox fx:id="cbMedioPagoEmpleado" prefWidth="170.0" styleClass="ps-combo" />
                    </VBox>
                    <Button minWidth="-Infinity" onAction="#agregarEmpleado" styleClass="ps-btn" text="Añadir">
                        <graphic>
                            <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.8" scaleY="0.8" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Button minWidth="-Infinity" fx:id="btnEditarEmpleado" disable="true" onAction="#editarEmpleado" styleClass="ps-btn-outline, ps-btn-tall" text="Guardar cambios">
                        <graphic>
                            <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Acciones sobre el empleado seleccionado -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label styleClass="ps-counter" text="Seleccioná un empleado para editarlo o imprimir sus tokens" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button minWidth="-Infinity" fx:id="btnRehacerToken" disable="true" onAction="#generarNuevoTokenEmpleado" styleClass="ps-btn-outline" text="Rehacer token">
                        <graphic>
                            <SVGPath content="M12 4a8 8 0 0 1 7.75 6h-2.08A6 6 0 1 0 12 18a5.96 5.96 0 0 0 4.24-1.76L13 13h7v7l-2.35-2.35A8 8 0 1 1 12 4z" scaleX="0.68" scaleY="0.68" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Button minWidth="-Infinity" fx:id="btnImprimirM" disable="true" onAction="#imprimirM" styleClass="ps-btn-outline" text="Token mañana">
                        <graphic>
                            <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.68" scaleY="0.68" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Button minWidth="-Infinity" fx:id="btnImprimirT" disable="true" onAction="#imprimirT" styleClass="ps-btn-outline" text="Token tarde">
                        <graphic>
                            <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.68" scaleY="0.68" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                    <Button minWidth="-Infinity" fx:id="btnDarBaja" disable="true" onAction="#eliminarEmpleado" styleClass="ps-btn-outline-danger" text="Dar de baja">
                        <graphic>
                            <SVGPath content="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zM7 6h10v13H7V6zm2 2v9h2V8H9zm4 0v9h2V8h-2z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                        </graphic>
                    </Button>
                </HBox>

                <!-- Tabla de empleados -->
                <TableView fx:id="tvGestionEmpleados" styleClass="ps-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGestionNombre" prefWidth="260" text="Nombre" />
                        <TableColumn fx:id="colGestionManiana" prefWidth="140" styleClass="ps-col-right" text="Sueldo mañana" />
                        <TableColumn fx:id="colGestionTarde" prefWidth="140" styleClass="ps-col-right" text="Sueldo tarde" />
                        <TableColumn fx:id="colGestionMedioPago" prefWidth="150" styleClass="ps-col-muted" text="Medio de pago" />
                        <TableColumn fx:id="colTokenM" prefWidth="150" styleClass="ps-col-muted" text="Token mañana" />
                        <TableColumn fx:id="colTokenT" prefWidth="150" styleClass="ps-col-muted" text="Token tarde" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder><Label styleClass="ps-placeholder" text="Todavía no hay empleados cargados" /></placeholder>
                </TableView>
            </VBox>
        </Tab>

        <Tab closable="false" text="Adelantos">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <fx:define>
                    <ToggleGroup fx:id="grupoPeriodoAdelantos" />
                </fx:define>

                <!-- Encabezado -->
                <VBox spacing="2.0">
                    <Label styleClass="ps-title" text="Adelantos de sueldo" />
                    <Label styleClass="ps-subtitle" text="Cuánto le queda por cobrar a cada empleado" />
                </VBox>

                <!-- Período -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarSemanalAdelantos" selected="true" styleClass="ps-pill" text="Esta semana" toggleGroup="$grupoPeriodoAdelantos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarAdelantosSemanaPasada" styleClass="ps-pill" text="Semana pasada" toggleGroup="$grupoPeriodoAdelantos" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarAdelantosDelMes" styleClass="ps-pill" text="Este mes" toggleGroup="$grupoPeriodoAdelantos" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglAdelantosRango" onAction="#mostrarSelectorRangoAdelantos" styleClass="ps-pill" text="Rango…" toggleGroup="$grupoPeriodoAdelantos">
                        <graphic>
                            <SVGPath content="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 10v10h14V10H5zm0-4v2h14V6H5z" scaleX="0.65" scaleY="0.65" styleClass="ps-icon" />
                        </graphic>
                    </ToggleButton>

                    <HBox fx:id="boxRangoAdelantos" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                        <HBox.margin><Insets left="6.0" /></HBox.margin>
                        <DatePicker fx:id="dpDesdeAdelanto" prefWidth="150.0" promptText="Desde" styleClass="ps-date" />
                        <Label styleClass="ps-muted" text="a" />
                        <DatePicker fx:id="dpHastaAdelanto" prefWidth="150.0" promptText="Hasta" styleClass="ps-date" />
                        <Button minWidth="-Infinity" onAction="#filtrarAdelantos" styleClass="ps-btn-dark" text="Aplicar" />
                    </HBox>
                </HBox>

                <!-- Totales -->
                <HBox styleClass="ps-stats">
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Trabajado" />
                        <Label fx:id="lblTotalTrabajadoAdelanto" styleClass="ps-stat-value" text="\$0" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Adelantado" />
                        <Label fx:id="lblTotalAdelantadoAdelanto" styleClass="ps-stat-value" text="\$0" />
                    </VBox>
                    <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                        <Label styleClass="ps-stat-label" text="Neto a pagar" />
                        <Label fx:id="lblNetoAdelanto" styleClass="ps-stat-value-lg" text="\$0" />
                    </VBox>
                </HBox>

                <!-- Saldos + panel del empleado -->
                <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tvSaldoEmpleados" prefWidth="620.0" styleClass="ps-table, ps-table-saldos" HBox.hgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colSaldoEmpleado" prefWidth="200" sortable="false" text="Empleado" />
                            <TableColumn fx:id="colSaldoTrabajado" prefWidth="140" sortable="false" styleClass="ps-col-right, ps-col-muted" text="Trabajado" />
                            <TableColumn fx:id="colSaldoAdelantado" prefWidth="140" sortable="false" styleClass="ps-col-right, ps-col-muted" text="Adelantado" />
                            <TableColumn fx:id="colSaldoNeto" prefWidth="140" sortable="false" styleClass="ps-col-right" text="Neto" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder><Label styleClass="ps-placeholder" text="No hay empleados cargados" /></placeholder>
                    </TableView>

                    <StackPane minWidth="380.0" prefWidth="430.0" styleClass="ps-detail-card">
                        <Label fx:id="lblSinEmpleadoAdelanto" styleClass="ps-placeholder" text="Elegí un empleado para ver sus adelantos y registrar uno nuevo" textAlignment="CENTER" wrapText="true" />

                        <VBox fx:id="panelEmpleadoAdelanto" spacing="12.0" visible="false">
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="lblEmpleadoAdelanto" styleClass="ps-detail-title" text="Empleado" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblLeQuedanAdelanto" styleClass="ps-detail-sub" text="Le quedan $0" />
                            </HBox>

                            <Label styleClass="ps-section-label" text="Adelantos del período" />
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minHeight="70.0" styleClass="ps-items-scroll" VBox.vgrow="ALWAYS">
                                <VBox fx:id="boxAdelantosEmpleado" />
                            </ScrollPane>

                            <Region styleClass="ps-dashed" />

                            <Label fx:id="lblNuevoAdelantoTitulo" styleClass="ps-section-title" text="Nuevo adelanto" />
                            <HBox spacing="12.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="ps-field-label" text="Monto" />
                                    <TextField fx:id="txtMontoAdelanto" maxWidth="Infinity" promptText="\$ 10.000" styleClass="ps-input" />
                                </VBox>
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="ps-field-label" text="Medio de pago" />
                                    <ComboBox fx:id="cbMedioPagoAdelanto" maxWidth="Infinity" styleClass="ps-combo" />
                                </VBox>
                            </HBox>
                            <HBox spacing="12.0">
                                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="ps-field-label" text="Descripción (opcional)" />
                                    <TextField fx:id="txtDescripcionAdelanto" maxWidth="Infinity" promptText="Adelanto pedido" styleClass="ps-input" />
                                </VBox>
                                <VBox spacing="6.0">
                                    <Label styleClass="ps-field-label" text="Fecha" />
                                    <DatePicker fx:id="dpFechaAdelanto" prefWidth="150.0" styleClass="ps-date" />
                                </VBox>
                            </HBox>

                            <HBox spacing="10.0">
                                <VBox.margin><Insets top="4.0" /></VBox.margin>
                                <Button minWidth="-Infinity" fx:id="btnGuardarAdelanto" maxWidth="Infinity" onAction="#guardarAdelanto" styleClass="ps-btn" text="Registrar adelanto" HBox.hgrow="ALWAYS">
                                    <graphic>
                                        <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.8" scaleY="0.8" styleClass="ps-icon" />
                                    </graphic>
                                </Button>
                                <Button minWidth="-Infinity" fx:id="btnCancelarEdicionAdelanto" managed="false" onAction="#cancelarEdicionAdelanto" styleClass="ps-btn-outline, ps-btn-tall" text="Cancelar" visible="false" />
                            </HBox>
                        </VBox>
                    </StackPane>
                </HBox>
            </VBox>
        </Tab>

        <Tab closable="false" text="Resumen semanal">
            <VBox spacing="16.0" styleClass="ps-root" stylesheets="@../styles/personal.css">
                <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

                <fx:define>
                    <ToggleGroup fx:id="grupoPeriodoResumen" />
                </fx:define>

                <!-- Encabezado + período -->
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <VBox spacing="2.0">
                        <Label styleClass="ps-title" text="Resumen semanal" />
                        <Label styleClass="ps-subtitle" text="Comprobante para entregar a cada empleado" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox fx:id="boxRangoResumen" alignment="CENTER_LEFT" managed="false" spacing="8.0" visible="false">
                        <HBox.margin><Insets right="6.0" /></HBox.margin>
                        <DatePicker fx:id="dpDesdeResumen" prefWidth="150.0" promptText="Desde" styleClass="ps-date" />
                        <Label styleClass="ps-muted" text="a" />
                        <DatePicker fx:id="dpHastaResumen" prefWidth="150.0" promptText="Hasta" styleClass="ps-date" />
                        <Button minWidth="-Infinity" onAction="#generarResumenSemanal" styleClass="ps-btn-dark" text="Aplicar" />
                    </HBox>
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarSemanaActualResumen" selected="true" styleClass="ps-pill" text="Esta semana" toggleGroup="$grupoPeriodoResumen" />
                    <ToggleButton minWidth="-Infinity" onAction="#mostrarSemanaPasadaResumen" styleClass="ps-pill" text="Semana pasada" toggleGroup="$grupoPeriodoResumen" />
                    <ToggleButton minWidth="-Infinity" fx:id="tglResumenRango" onAction="#mostrarSelectorRangoResumen" styleClass="ps-pill" text="Rango…" toggleGroup="$grupoPeriodoResumen">
                        <graphic>
                            <SVGPath content="M7 2h2v2h6V2h2v2h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2V2zM5 10v10h14V10H5zm0-4v2h14V6H5z" scaleX="0.65" scaleY="0.65" styleClass="ps-icon" />
                        </graphic>
                    </ToggleButton>
                </HBox>

                <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                    <!-- Lista de empleados -->
                    <VBox minWidth="300.0" prefWidth="360.0" spacing="14.0">
                        <ListView fx:id="lvEmpleadosResumen" styleClass="ps-emp-list" VBox.vgrow="ALWAYS">
                            <placeholder><Label styleClass="ps-placeholder" text="No hay empleados cargados" /></placeholder>
                        </ListView>
                        <Button minWidth="-Infinity" maxWidth="Infinity" onAction="#imprimirTodosResumenSemanal" styleClass="ps-btn-outline, ps-btn-tall" text="Imprimir todos">
                            <graphic>
                                <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                            </graphic>
                        </Button>
                    </VBox>

                    <!-- Vista previa del comprobante -->
                    <VBox spacing="16.0" styleClass="ps-paper-bg" HBox.hgrow="ALWAYS">
                        <StackPane VBox.vgrow="ALWAYS">
                            <Label fx:id="lblSinEmpleadoResumen" styleClass="ps-placeholder" text="Elegí un empleado para ver su comprobante" />

                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="ps-items-scroll">
                                <VBox fx:id="panelComprobante" spacing="16.0" styleClass="ps-paper" visible="false">
                                    <!-- Cabecera -->
                                    <HBox alignment="BOTTOM_LEFT" styleClass="ps-comp-head">
                                        <VBox spacing="2.0">
                                            <Label styleClass="ps-comp-kicker" text="COMPROBANTE DE PAGO" />
                                            <Label fx:id="lblCompNombre" styleClass="ps-comp-nombre" text="Empleado" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <VBox alignment="BOTTOM_RIGHT" spacing="2.0">
                                            <Label fx:id="lblCompPeriodoTitulo" styleClass="ps-comp-detalle" text="Semana del" />
                                            <Label fx:id="lblCompPeriodo" styleClass="ps-comp-texto" text="" />
                                        </VBox>
                                    </HBox>

                                    <!-- Totales -->
                                    <HBox styleClass="ps-comp-totales">
                                        <VBox maxWidth="Infinity" spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="ps-stat-label" text="Trabajado" />
                                            <Label fx:id="lblCompTrabajado" styleClass="ps-comp-monto" text="\$0" />
                                        </VBox>
                                        <VBox maxWidth="Infinity" spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="ps-stat-label" text="Adelantos" />
                                            <Label fx:id="lblCompAdelantos" styleClass="ps-comp-monto" text="\$0" />
                                        </VBox>
                                        <VBox maxWidth="Infinity" spacing="2.0" HBox.hgrow="ALWAYS">
                                            <Label styleClass="ps-stat-label" text="Neto a pagar" />
                                            <Label fx:id="lblCompNeto" styleClass="ps-stat-value-lg" text="\$0" />
                                        </VBox>
                                    </HBox>

                                    <!-- Turnos -->
                                    <VBox>
                                        <HBox styleClass="ps-comp-seccion">
                                            <Label styleClass="ps-comp-detalle" text="Turnos trabajados" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblCompCantTurnos" styleClass="ps-comp-detalle" text="0" />
                                        </HBox>
                                        <VBox fx:id="boxCompTurnos" />
                                    </VBox>

                                    <!-- Adelantos -->
                                    <VBox>
                                        <HBox styleClass="ps-comp-seccion">
                                            <Label styleClass="ps-comp-detalle" text="Adelantos" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label fx:id="lblCompCantAdelantos" styleClass="ps-comp-detalle" text="0" />
                                        </HBox>
                                        <VBox fx:id="boxCompAdelantos" />
                                    </VBox>

                                    <!-- Firmas -->
                                    <HBox spacing="50.0">
                                        <VBox.margin><Insets top="40.0" /></VBox.margin>
                                        <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                            <Region maxWidth="Infinity" styleClass="ps-firma-linea" />
                                            <Label styleClass="ps-comp-detalle" text="Firma del empleado" />
                                        </VBox>
                                        <VBox alignment="CENTER" spacing="6.0" HBox.hgrow="ALWAYS" maxWidth="Infinity">
                                            <Region maxWidth="Infinity" styleClass="ps-firma-linea" />
                                            <Label styleClass="ps-comp-detalle" text="Aclaración" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </ScrollPane>
                        </StackPane>

                        <HBox alignment="CENTER_RIGHT">
                            <Button minWidth="-Infinity" fx:id="btnImprimirResumen" disable="true" onAction="#imprimirResumenSemanal" styleClass="ps-btn" text="Imprimir">
                                <graphic>
                                    <SVGPath content="M7 3h10v4h1a3 3 0 0 1 3 3v6h-4v5H7v-5H3v-6a3 3 0 0 1 3-3h1V3zm2 2v2h6V5H9zm-3 4a1 1 0 0 0-1 1v4h2v-2h10v2h2v-4a1 1 0 0 0-1-1H6zm3 5v5h6v-5H9z" scaleX="0.72" scaleY="0.72" styleClass="ps-icon" />
                                </graphic>
                            </Button>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </Tab>
    </tabs>
</TabPane>
