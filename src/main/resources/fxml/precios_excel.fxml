<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Productos > Precios (Excel): exportar la lista de precios e importar precios nuevos -->
<VBox spacing="16.0" styleClass="ps-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PreciosExcelController">
    <stylesheets>
        <URL value="@../styles/personal.css" />
    </stylesheets>
    <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

    <VBox spacing="2.0">
        <Label styleClass="ps-title" text="Precios por Excel" />
        <Label styleClass="ps-subtitle" text="Exportá la lista de precios, modificala en Excel y volvé a importarla. Columnas: Código, Producto, Precio y Tipo." />
    </VBox>

    <HBox minHeight="-Infinity" spacing="18.0">
        <!-- Exportar -->
        <VBox spacing="10.0" styleClass="ps-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="ps-section-title" text="Exportar precios" />
            <Label styleClass="ps-item-sub" text="Genera un Excel con todos los productos del catálogo." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button minWidth="-Infinity" onAction="#exportar" styleClass="ps-btn" text="Exportar a Excel">
                    <graphic>
                        <SVGPath content="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 2v16h12V9h-5V4H6zm5 7h2v4.17l1.59-1.58L16 15l-4 4-4-4 1.41-1.41L11 15.17V11z" scaleX="0.75" scaleY="0.75" styleClass="ps-icon" />
                    </graphic>
                </Button>
                <Label fx:id="lblExportado" styleClass="ps-detail-sub" text="" wrapText="true" />
            </HBox>
        </VBox>

        <!-- Importar -->
        <VBox spacing="10.0" styleClass="ps-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="ps-section-title" text="Importar precios" />
            <Label styleClass="ps-item-sub" text="Elegí el Excel: primero vas a ver qué precios cambian y después decidís si sobrescribirlos." wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button minWidth="-Infinity" onAction="#elegirArchivo" styleClass="ps-btn-dark, ps-btn-tall" text="Elegir Excel…" />
                <Label fx:id="lblArchivo" styleClass="ps-detail-sub" text="" wrapText="true" />
            </HBox>
        </VBox>

        <!-- Deshacer -->
        <VBox spacing="10.0" styleClass="ps-card" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="ps-section-title" text="Deshacer última importación" />
            <Label styleClass="ps-item-sub" text="Antes de cada importación se guarda una copia de todos los precios. Si te equivocaste, volvé atrás." wrapText="true" />
            <Label fx:id="lblUltimaImportacion" styleClass="ps-detail-sub" text="" wrapText="true" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Button fx:id="btnDeshacer" disable="true" minWidth="-Infinity" onAction="#deshacerImportacion" styleClass="ps-btn-outline-danger, ps-btn-tall" text="Deshacer" />
                <Button minWidth="-Infinity" onAction="#abrirCarpetaCopias" styleClass="ps-btn-outline, ps-btn-tall" text="Ver copias" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Vista previa de la importación -->
    <VBox fx:id="boxVistaPrevia" managed="false" spacing="12.0" visible="false" VBox.vgrow="ALWAYS">
        <HBox styleClass="ps-stats">
            <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat" HBox.hgrow="ALWAYS">
                <Label styleClass="ps-stat-label" text="Precios que cambian" />
                <Label fx:id="lblCambian" styleClass="ps-stat-value-lg" text="0" />
            </VBox>
            <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                <Label styleClass="ps-stat-label" text="Sin cambios" />
                <Label fx:id="lblIguales" styleClass="ps-stat-value" text="0" />
            </VBox>
            <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                <Label styleClass="ps-stat-label" text="No están en el sistema" />
                <Label fx:id="lblNuevos" styleClass="ps-stat-value" text="0" />
            </VBox>
            <VBox maxWidth="Infinity" spacing="2.0" styleClass="ps-stat, ps-stat-divider" HBox.hgrow="ALWAYS">
                <Label styleClass="ps-stat-label" text="Con errores" />
                <Label fx:id="lblErrores" styleClass="ps-stat-value" text="0" />
            </VBox>
        </HBox>

        <TableView fx:id="tblVistaPrevia" styleClass="ps-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="100" text="Código" />
                <TableColumn fx:id="colProducto" prefWidth="280" text="Producto" />
                <TableColumn fx:id="colPrecioActual" prefWidth="140" styleClass="ps-col-right, ps-col-muted" text="Precio actual" />
                <TableColumn fx:id="colPrecioNuevo" prefWidth="140" styleClass="ps-col-right" text="Precio nuevo" />
                <TableColumn fx:id="colEstado" prefWidth="220" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <CheckBox fx:id="chkAgregarNuevos" styleClass="ps-detail-sub" text="Agregar también los productos que no están en el sistema" />
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="-Infinity" onAction="#cancelarImportacion" styleClass="ps-btn-outline, ps-btn-tall" text="Cancelar" />
            <Button fx:id="btnSobrescribir" minWidth="-Infinity" onAction="#sobrescribir" styleClass="ps-btn" text="Sobrescribir precios" />
        </HBox>
    </VBox>
</VBox>
