<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla principal (back-office): barra de navegación fina arriba y el
     módulo elegido ocupando todo el resto de la pantalla. -->
<AnchorPane id="AnchorPane" prefHeight="1080.0" prefWidth="1920.0" styleClass="menu-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MenuController">
    <stylesheets>
        <URL value="@../styles/menu.css" />
    </stylesheets>
   <children>
      <!-- Barra de navegación superior -->
      <HBox fx:id="barraNavegacion" alignment="CENTER_LEFT" prefHeight="64.0" spacing="6.0" styleClass="nav-bar" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Tocarlo vuelve a la pantalla de inicio (hora y fecha) -->
            <Label fx:id="lblMarca" minWidth="-Infinity" onMouseClicked="#mostrarInicio" styleClass="nav-marca" text="SISTEMA DE VENTAS">
               <tooltip><Tooltip text="Volver al inicio" /></tooltip>
            </Label>

            <!-- Acceso destacado: abre Nueva Venta a pantalla completa -->
            <Button fx:id="btnCrearVenta" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleCrearVenta" styleClass="nav-btn-venta" text="Nueva Venta">
               <graphic>
                  <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.85" scaleY="0.85" styleClass="nav-icono" />
               </graphic>
               <tooltip><Tooltip text="Nueva Venta (F1)" /></tooltip>
            </Button>

            <Region minWidth="1.0" prefHeight="34.0" styleClass="nav-separador" />

            <!-- Módulos: el que está abierto queda resaltado en azul -->
            <Button fx:id="btnHistorialVentas" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleHistorialVentas" styleClass="nav-btn" text="Historial">
               <tooltip><Tooltip text="Historial y reportes de ventas (F2)" /></tooltip>
            </Button>
            <Button fx:id="btnVisualizarProductos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleVisualizarProductos" styleClass="nav-btn" text="Productos">
               <tooltip><Tooltip text="Catálogo de productos (F3)" /></tooltip>
            </Button>
            <Button fx:id="btnIngresarIndividual" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleIngresarIndividual" styleClass="nav-btn" text="Stock">
               <tooltip><Tooltip text="Stock de productos secos (F4)" /></tooltip>
            </Button>
            <Button fx:id="btnPersonal" minWidth="-Infinity" mnemonicParsing="false" onAction="#handlePersonal" styleClass="nav-btn" text="Personal">
               <tooltip><Tooltip text="Personal (F5)" /></tooltip>
            </Button>
            <Button fx:id="btnGastos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleGastos" styleClass="nav-btn" text="Gastos">
               <tooltip><Tooltip text="Gastos y balance (F6)" /></tooltip>
            </Button>
            <Button fx:id="btnVisualizarTarjeta" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleVisualizarTarjeta" styleClass="nav-btn" text="Tarjetas">
               <tooltip><Tooltip text="Tarjetas (F7)" /></tooltip>
            </Button>
            <Region HBox.hgrow="ALWAYS" />

            <!-- Estilo, Mercado Pago y Actualizaciones. Se pinta de verde cuando
                 hay una versión nueva publicada -->
            <Button fx:id="btnConfiguracion" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleConfiguracion" styleClass="nav-btn" text="Configuración">
               <graphic>
                  <SVGPath content="M19.14 12.94a7.07 7.07 0 0 0 0-1.88l2.03-1.58a.5.5 0 0 0 .12-.64l-1.92-3.32a.5.5 0 0 0-.61-.22l-2.39.96a7.03 7.03 0 0 0-1.62-.94l-.36-2.54A.5.5 0 0 0 13.9 2h-3.84a.5.5 0 0 0-.49.42l-.36 2.54c-.59.24-1.13.56-1.62.94l-2.39-.96a.5.5 0 0 0-.61.22L2.67 8.48a.5.5 0 0 0 .12.64l2.03 1.58a7.07 7.07 0 0 0 0 1.88l-2.03 1.58a.5.5 0 0 0-.12.64l1.92 3.32c.13.22.39.3.61.22l2.39-.96c.49.38 1.03.7 1.62.94l.36 2.54c.05.24.25.42.49.42h3.84c.24 0 .44-.18.49-.42l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.48 0 .61-.22l1.92-3.32a.5.5 0 0 0-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1 1 12 8.5a3.5 3.5 0 0 1 0 7z" scaleX="0.75" scaleY="0.75" styleClass="nav-icono-gris" />
               </graphic>
               <tooltip><Tooltip text="Estilo, Mercado Pago y actualizaciones (F8)" /></tooltip>
            </Button>
            <Label fx:id="lblVersion" minWidth="-Infinity" styleClass="nav-version" text="" />
         </children>
      </HBox>

      <!-- Área del módulo abierto: ocupa todo el ancho debajo de la barra -->
      <AnchorPane fx:id="contenidoPrincipal" styleClass="content-area" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="64.0">
         <children>
            <!-- Inicio: en blanco, solo la hora y la fecha en grande -->
            <VBox fx:id="panelInicio" alignment="CENTER" spacing="4.0" styleClass="inicio-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                  <Label fx:id="lblHoraInicio" styleClass="inicio-hora" text="00:00" />
                  <Label fx:id="lblFechaInicio" styleClass="inicio-fecha" text="" />

                  <!-- Clima de la ciudad elegida en Configuración > Estilo del sistema -->
                  <HBox fx:id="boxClima" alignment="CENTER" maxWidth="-Infinity" spacing="22.0" styleClass="clima-tarjeta">
                     <VBox.margin><Insets top="40.0" /></VBox.margin>
                     <children>
                        <Label fx:id="lblClimaIcono" styleClass="clima-icono" text="☁" />
                        <VBox alignment="CENTER_LEFT" spacing="2.0">
                           <children>
                              <Label fx:id="lblClimaTemp" styleClass="clima-temp" text="—" />
                              <Label fx:id="lblClimaDesc" styleClass="clima-desc" text="Cargando clima…" />
                           </children>
                        </VBox>
                        <Region styleClass="clima-separador" />
                        <VBox alignment="CENTER_LEFT" spacing="4.0">
                           <children>
                              <Label fx:id="lblClimaCiudad" styleClass="clima-ciudad" text="" />
                              <Label fx:id="lblClimaDetalle" styleClass="clima-detalle" text="" />
                              <Label fx:id="lblClimaDetalle2" styleClass="clima-detalle" text="" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <AnchorPane fx:id="overlayClientes" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
