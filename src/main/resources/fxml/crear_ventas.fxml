<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" fx:id="rootPane" prefHeight="800.0" prefWidth="1200.0" styleClass="mainFxmlClass, nv-root" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Crear_ventasController">
    <stylesheets>
        <URL value="@../styles/crear_ventas.css" />
    </stylesheets>
    
   <children>
      <!-- Header con botón regresar y búsqueda -->
      <HBox alignment="CENTER_LEFT" spacing="20.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
         <children>
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#cerrarVentas" styleClass="boton" text="&lt; Regresar" />

            <!-- Selector de caja: 3 ventas en paralelo. Teclado numérico: / = Caja 1, * = Caja 2, - = Caja 3 -->
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <ToggleButton minWidth="-Infinity" fx:id="tbCaja1" focusTraversable="false" mnemonicParsing="false" onAction="#seleccionarCajaClick" prefWidth="110.0" selected="true" styleClass="boton-caja" text="Caja 1" />
                  <ToggleButton minWidth="-Infinity" fx:id="tbCaja2" focusTraversable="false" mnemonicParsing="false" onAction="#seleccionarCajaClick" prefWidth="110.0" styleClass="boton-caja" text="Caja 2" />
                  <ToggleButton minWidth="-Infinity" fx:id="tbCaja3" focusTraversable="false" mnemonicParsing="false" onAction="#seleccionarCajaClick" prefWidth="110.0" styleClass="boton-caja" text="Caja 3" />
                  <!-- Genera el QR por un monto que se escribe a mano (en las tres cajas) -->
                  <Button focusTraversable="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#qrPersonalizado" styleClass="boton-qr" text="QR personalizado (+)" />
               </children>
            </HBox>

            <!-- Barra de código de barra (se ingresa con Enter, que el lector envía solo)
                 y, a la derecha, un lugar fijo por caja para avisar "Caja n ✓ $monto"
                 cuando cobra por QR una caja que no está en pantalla -->
            <AnchorPane prefHeight="48.0" styleClass="anchoBarra" HBox.hgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="5.0">
                     <children>
                        <Label minWidth="-Infinity" styleClass="textoBarra" text="Código de barra" />
                        <TextField fx:id="txtCodigoDeBarra" minWidth="200.0" prefHeight="38.0" prefWidth="230.0" styleClass="codigoBarra" />
                        <!-- Recuadros de las 3 cajas: ocupan el espacio libre de la barra -->
                        <HBox alignment="CENTER_RIGHT" spacing="20.0" HBox.hgrow="ALWAYS">
                           <children>
                        <!-- Recuadro de cada caja: "QR Caja n" con su barra de tiempo mientras
                             espera el pago, o "Caja n ✓ $monto" cuando ya pagó -->
                        <VBox fx:id="slotCaja1" alignment="CENTER" maxWidth="290.0" prefWidth="215.0" spacing="3.0" styleClass="aviso-pago" visible="false" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblPagoCaja1" styleClass="aviso-pago-texto" />
                              <ProgressBar fx:id="barraCaja1" maxWidth="1.7976931348623157E308" styleClass="barra-aviso" />
                           </children>
                        </VBox>
                        <VBox fx:id="slotCaja2" alignment="CENTER" maxWidth="290.0" prefWidth="215.0" spacing="3.0" styleClass="aviso-pago" visible="false" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblPagoCaja2" styleClass="aviso-pago-texto" />
                              <ProgressBar fx:id="barraCaja2" maxWidth="1.7976931348623157E308" styleClass="barra-aviso" />
                           </children>
                        </VBox>
                        <VBox fx:id="slotCaja3" alignment="CENTER" maxWidth="290.0" prefWidth="215.0" spacing="3.0" styleClass="aviso-pago" visible="false" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="lblPagoCaja3" styleClass="aviso-pago-texto" />
                              <ProgressBar fx:id="barraCaja3" maxWidth="1.7976931348623157E308" styleClass="barra-aviso" />
                           </children>
                        </VBox>
                           </children>
                        </HBox>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>

            <Button minWidth="-Infinity" fx:id="btnWifi" mnemonicParsing="false" onAction="#toggleWifiLocal" styleClass="boton-wifi" text="📶 WiFi Local: OFF" />
         </children>
      </HBox>

      <!-- Contenedor principal de tablas -->
      <HBox spacing="15.0" AnchorPane.bottomAnchor="200.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="80.0">
         <children>
            <!-- Tabla de productos (70% del ancho) -->
            <TableView fx:id="tblVistaProductos" prefHeight="520.0" prefWidth="840.0" styleClass="tablaCrearVenta" HBox.hgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colProducto" prefWidth="75.0" text="Producto" />
                <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
                <TableColumn fx:id="colPeso" prefWidth="75.0" text="Peso" />
                <TableColumn fx:id="colTotal" prefWidth="75.0" text="Total" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <!-- Tabla de vuelto (30% del ancho) -->
            <TableView fx:id="tbolVueltos" prefHeight="516.0" prefWidth="461.0" styleClass="tablaCrearVenta">
              <columns>
                <TableColumn fx:id="colRecibido" prefWidth="75.0" text="Recibido" />
                <TableColumn fx:id="colVuelto" prefWidth="75.0" text="Vuelto" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </HBox>

      <!-- Panel inferior con información de pago -->
      <HBox prefHeight="180.0" spacing="15.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
         <children>
            <!-- Panel Medio de Pago -->
            <VBox alignment="CENTER" prefHeight="180.0" prefWidth="369.0" styleClass="contenedor, nv-card-oscura" HBox.hgrow="SOMETIMES">
               <children>
                  <Label styleClass="titulo" text="Medio de pago">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblMedioPago" styleClass="medioPago" text="---">
                     <font>
                        <Font size="24.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
            
            <!-- Panel Total a Pagar -->
            <AnchorPane prefWidth="360.0" HBox.hgrow="SOMETIMES">
               <children>
                  <VBox alignment="CENTER" prefHeight="180.0" prefWidth="360.0" styleClass="contenedor, nv-card-oscura"
                        AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
                        AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                     <children>
                        <Label styleClass="titulo" text="Total a pagar">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                        <Label fx:id="lblCantidadPagar" styleClass="numeroTotal" text="---">
                           <font>
                              <Font size="24.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>

                  <!-- Badge de descuento por tarjeta de fidelidad: oculto por defecto -->
                  <Label fx:id="lblBadgeDescuento"
                         text="-10% TARJETA"
                         visible="false"
                         managed="false"
                         style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 4px 12px; -fx-background-radius: 12px;"
                         AnchorPane.topAnchor="-10.0"
                         AnchorPane.rightAnchor="12.0"/>
               </children>
            </AnchorPane>
            
            <!-- Panel Mercado Pago -->
            <VBox prefHeight="180.0" prefWidth="488.0" styleClass="contenedor, nv-panel-mp" HBox.hgrow="ALWAYS">
               <children>
                  <!-- Título con botones de navegación -->
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="botonDeslizante" text="&lt;" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" styleClass="botonDeslizante" text="&gt;" />
                        <Label prefHeight="43.0" prefWidth="505.0" styleClass="subtitulo" text="Transferencias de Mercado Pago" />
                     </children>
                  </HBox>
                  
                  <!-- Información de la transacción -->
                  <HBox spacing="10.0" VBox.vgrow="ALWAYS">
                     <children>
                        <!-- Panel Monto -->
                        <VBox alignment="CENTER" styleClass="anchor-pane-blanco" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="subtitulo" text="Monto:">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblMonto" styleClass="texto-MP" text="--">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        
                        <!-- Panel Hora -->
                        <VBox alignment="CENTER" styleClass="anchor-pane-blanco" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="subtitulo" text="Hora:">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblHora" styleClass="texto-MP" text="--">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                        
                        <!-- Panel Aprobado -->
                        <VBox fx:id="vBoxAprobado" alignment="CENTER" styleClass="anchor-pane-blanco" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="subtitulo" text="Aprobado:">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Label>
                              <Label fx:id="lblEstado" styleClass="texto-MP" text="--">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
      </HBox>

      <!-- Overlay grande de pago exitoso: oculto por defecto, se muestra al confirmarse el cobro QR
           o una transferencia (el título dice "QR" o "TRANSFERENCIA" según el caso) -->
      <StackPane fx:id="panelPagoExitoso" styleClass="panelPagoExitoso" visible="false" managed="false"
                 AnchorPane.topAnchor="100.0" AnchorPane.bottomAnchor="100.0"
                 AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="150.0">
         <children>
            <VBox alignment="CENTER" spacing="20.0">
               <children>
                  <Label styleClass="iconoPagoExitoso" text="✓" />
                  <Label fx:id="lblTituloPagoExitoso" styleClass="textoPagoExitoso" text="QR" />
                  <Label fx:id="lblMontoRecibido" styleClass="montoPagoExitoso" text="Pago recibido: 0" />
                  <Label fx:id="lblSubtextoPagoExitoso" styleClass="subtextoPagoExitoso" text="Operación exitosa" />
               </children>
            </VBox>
         </children>
      </StackPane>

      <!-- Cartel persistente de "QR listo para cobrar": se muestra al generar el cobro QR (F2) y
           permanece activo (sin auto-ocultarse) hasta que se concrete la venta, se cancele o se
           cambie el medio de pago. Al concretarse, se desvanece en 3 segundos. -->
      <StackPane fx:id="panelQRListo" styleClass="panelQRListo" visible="false" managed="false"
                 AnchorPane.topAnchor="65.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="220.0">
         <children>
            <VBox alignment="CENTER" spacing="14.0">
               <children>
                  <Label fx:id="lblQRListo" styleClass="textoQRListo" text="QR GENERADO" />
                  <!-- Tiempo que le queda al QR antes de expirar: se vacía de a poco -->
                  <ProgressBar fx:id="barraQR" maxWidth="1.7976931348623157E308" progress="1.0" styleClass="barraQR" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
