<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<TabPane prefHeight="650.0" prefWidth="1000.0" stylesheets="@../styles/empleadoYGastos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.GananciaRealController">

    <tabs>
        <Tab closable="false" text="REGISTRAR COMPRA">
            <ScrollPane fitToWidth="true" styleClass="eg-scroll">
                <VBox spacing="15" styleClass="container">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <Label styleClass="titulo-seccion" text="Registrar Compra de Mercadería" />

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="seccion-formulario">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                        <DatePicker fx:id="dpFechaCompra" promptText="Fecha" />
                        <ComboBox fx:id="cbCategoriaCompra" prefWidth="160.0" promptText="Categoría" styleClass="select-producto" />
                        <TextField fx:id="txtUnidadesCompra" prefWidth="110.0" promptText="Unidades" styleClass="input-number" />
                        <TextField fx:id="txtKgCompra" prefWidth="110.0" promptText="Kg totales" styleClass="input-number" />
                        <TextField fx:id="txtCostoCompra" prefWidth="130.0" promptText="Costo total" styleClass="input-number" />
                        <Button onAction="#guardarCompra" styleClass="boton" text="Guardar Compra" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="seccion-formulario">
                        <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                        <Label styleClass="form-label" text="Ver desde:" />
                        <DatePicker fx:id="dpDesdeCompra" />
                        <Label styleClass="form-label" text="hasta:" />
                        <DatePicker fx:id="dpHastaCompra" />
                        <Button onAction="#filtrarCompras" styleClass="boton-secundario, boton" text="Filtrar" />
                    </HBox>

                    <VBox styleClass="seccion-tabla">
                        <TableView fx:id="tvCompras" prefHeight="380">
                            <columns>
                                <TableColumn fx:id="colCompraFecha" prefWidth="120" text="Fecha" />
                                <TableColumn fx:id="colCompraCategoria" prefWidth="150" text="Categoría" />
                                <TableColumn fx:id="colCompraUnidades" prefWidth="100" text="Unidades" />
                                <TableColumn fx:id="colCompraKg" prefWidth="130" text="Kg totales" />
                                <TableColumn fx:id="colCompraCosto" prefWidth="140" text="Costo total" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                            <Button fx:id="btnBorrarCompra" disable="true" onAction="#borrarCompra" styleClass="boton-eliminar" text="Eliminar Compra" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab closable="false" text="CIERRE DE STOCK">
            <ScrollPane fitToWidth="true" styleClass="eg-scroll">
                <VBox spacing="15" styleClass="container">
                    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                    <Label styleClass="titulo-seccion" text="Cierre de Stock por Categoría" />

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="seccion-formulario">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                        <DatePicker fx:id="dpFechaCierre" promptText="Fecha de cierre" />
                        <ComboBox fx:id="cbCategoriaCierre" prefWidth="160.0" promptText="Categoría" styleClass="select-producto" />
                        <TextField fx:id="txtKgRestantes" prefWidth="140.0" promptText="Kg restantes" styleClass="input-number" />
                        <Button onAction="#guardarCierre" styleClass="boton" text="Guardar Cierre" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="seccion-formulario">
                        <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                        <Label styleClass="form-label" text="Ver desde:" />
                        <DatePicker fx:id="dpDesdeCierre" />
                        <Label styleClass="form-label" text="hasta:" />
                        <DatePicker fx:id="dpHastaCierre" />
                        <Button onAction="#filtrarCierres" styleClass="boton-secundario, boton" text="Filtrar" />
                    </HBox>

                    <VBox styleClass="seccion-tabla">
                        <TableView fx:id="tvCierres" prefHeight="380">
                            <columns>
                                <TableColumn fx:id="colCierreFecha" prefWidth="150" text="Fecha de cierre" />
                                <TableColumn fx:id="colCierreCategoria" prefWidth="200" text="Categoría" />
                                <TableColumn fx:id="colCierreKg" prefWidth="180" text="Kg restantes" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                            <Button fx:id="btnBorrarCierre" disable="true" onAction="#borrarCierre" styleClass="boton-eliminar" text="Eliminar Cierre" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab closable="false" text="RESUMEN Y ALERTAS">
            <ScrollPane fitToWidth="true" styleClass="eg-scroll">
                <VBox spacing="16" styleClass="container">
                    <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

                    <Label styleClass="titulo-seccion" text="Ganancia Real del Período" />

                    <HBox alignment="CENTER_LEFT" spacing="15" styleClass="seccion-formulario">
                        <padding><Insets bottom="12" left="15" right="15" top="12" /></padding>
                        <Label styleClass="precio-label" text="Desde:" />
                        <DatePicker fx:id="dpInicioResumen" />
                        <Label styleClass="precio-label" text="Hasta:" />
                        <DatePicker fx:id="dpFinResumen" />
                        <Button onAction="#calcularResumen" styleClass="boton" text="Calcular" />
                        <Button onAction="#mostrarResumenSemanal" styleClass="boton-secundario, boton" text="Semanal" />
                    </HBox>

                    <VBox fx:id="panelResumenDatos" spacing="16">
                        <Label styleClass="titulo-subseccion" text="Resultado" />
                        <HBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte, tarjeta-ventas" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="VENTAS" />
                                <Label fx:id="lblResVentas" styleClass="monto-tarjeta" text=" 0" />
                                <Label styleClass="subtitulo-tarjeta" text="Total del período" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte, tarjeta-cmv" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="CMV" />
                                <Label fx:id="lblResCMV" styleClass="monto-tarjeta" text=" 0" />
                                <Label styleClass="subtitulo-tarjeta" text="Costo de lo vendido" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte, tarjeta-gasto-efectivo" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="GASTOS" />
                                <Label fx:id="lblResGastos" styleClass="monto-tarjeta" text=" 0" />
                                <Label styleClass="subtitulo-tarjeta" text="Total del período" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte, tarjeta-sueldos" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="SUELDOS" />
                                <Label fx:id="lblResSueldos" styleClass="monto-tarjeta" text=" 0" />
                                <Label styleClass="subtitulo-tarjeta" text="Total del período" />
                            </VBox>
                        </HBox>
                        <HBox alignment="CENTER" spacing="20" VBox.vgrow="ALWAYS">
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="220" spacing="6" styleClass="tarjeta-reporte, tarjeta-utilidad" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta, texto-grande" text="GANANCIA REAL" />
                                <Label fx:id="lblResGananciaReal" styleClass="monto-tarjeta, monto-grande" text=" 0" />
                                <Label styleClass="subtitulo-tarjeta" text="Ventas - CMV - Gastos - Sueldos" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="MARGEN REAL %" />
                                <Label fx:id="lblResMargenReal" styleClass="monto-tarjeta" text=" 0%" />
                                <Label styleClass="subtitulo-tarjeta" text="Ganancia real / Ventas" />
                            </VBox>
                            <VBox alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="180" spacing="6" styleClass="tarjeta-reporte" HBox.hgrow="ALWAYS">
                                <Label styleClass="titulo-tarjeta" text="GANANCIA / CMV %" />
                                <Label fx:id="lblResGananciaSobreCosto" styleClass="monto-tarjeta" text=" 0%" />
                                <Label styleClass="subtitulo-tarjeta" text="Ganancia real / CMV" />
                            </VBox>
                        </HBox>

                        <Label styleClass="titulo-subseccion" text="Alertas" />
                        <VBox fx:id="contenedorAlertas" spacing="10" />
                        <Label fx:id="lblSinAlertas" styleClass="sin-alertas" text="Sin alertas en el período" visible="false" managed="false" />
                    </VBox>

                    <Label fx:id="lblNotaResumen" styleClass="subtitulo-tarjeta" text="Cargá compras y cierre de stock para ver la ganancia real de este período." visible="false" managed="false" wrapText="true" />
                </VBox>
            </ScrollPane>
        </Tab>

        <Tab closable="false" text="CONFIGURACIÓN DE RENDIMIENTO">
            <ScrollPane fitToWidth="true" styleClass="eg-scroll">
                <VBox spacing="16" styleClass="container">
                    <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

                    <Label styleClass="titulo-seccion" text="Configuración de Rendimiento por Categoría" />
                    <Label styleClass="subtitulo-tarjeta" text="Doble clic en una celda para editar. Los % se muestran en escala 0-100." wrapText="true" />

                    <VBox styleClass="seccion-tabla">
                        <TableView fx:id="tvConfigRendimiento" editable="true" prefHeight="200">
                            <columns>
                                <TableColumn fx:id="colCatConfig" prefWidth="150" text="Categoría" />
                                <TableColumn fx:id="colAprovechableConfig" prefWidth="220" text="Aprovechable %" />
                                <TableColumn fx:id="colUmbralConfig" prefWidth="220" text="Umbral de alerta %" />
                                <TableColumn fx:id="colCostoRefConfig" prefWidth="220" text="Costo referencia por kg" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
                            <Button onAction="#guardarConfigRendimiento" styleClass="boton" text="Guardar Cambios" />
                        </HBox>
                    </VBox>

                    <Label styleClass="titulo-subseccion" text="Alerta de precio bajo lista" />
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="seccion-formulario">
                        <padding><Insets bottom="15" left="15" right="15" top="15" /></padding>
                        <Label styleClass="form-label" text="Umbral de desviación de precio (%):" />
                        <TextField fx:id="txtUmbralDesviacionPrecio" prefWidth="100.0" styleClass="input-number" />
                        <Button onAction="#guardarUmbralPrecio" styleClass="boton" text="Guardar" />
                    </HBox>
                </VBox>
            </ScrollPane>
        </Tab>
    </tabs>
</TabPane>
