<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Tarjetas de fidelidad: alta (una o en lote), búsqueda, sellos y estado.
     Usa la misma hoja de estilos (y paleta azul) que Personal / Gastos / Stock. -->
<VBox prefHeight="766.0" prefWidth="1166.0" spacing="16.0" styleClass="ps-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TarjetaController">
    <stylesheets>
        <URL value="@../styles/personal.css" />
    </stylesheets>
    <padding><Insets bottom="24.0" left="28.0" right="28.0" top="22.0" /></padding>

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="2.0">
            <Label styleClass="ps-title" text="Tarjetas de fidelidad" />
            <Label styleClass="ps-subtitle" text="Generá tarjetas, activalas y administrá sus sellos" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnExportarExcel" minWidth="-Infinity" mnemonicParsing="false" onAction="#exportarExcel" styleClass="ps-btn-outline, ps-btn-tall" text="Exportar">
            <graphic>
                <SVGPath content="M6 2h8l6 6v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 2v16h12V9h-5V4H6zm5 7h2v4.17l1.59-1.58L16 15l-4 4-4-4 1.41-1.41L11 15.17V11z" scaleX="0.72" scaleY="0.72" styleClass="ps-icon" />
            </graphic>
        </Button>
    </HBox>

    <!-- Nueva tarjeta: descuento y tope se aplican a la tarjeta (o al lote) que se genere -->
    <HBox alignment="BOTTOM_LEFT" spacing="14.0" styleClass="ps-card">
        <VBox spacing="6.0">
            <Label styleClass="ps-field-label" text="Descuento (%)" />
            <TextField fx:id="txtDescuento" prefWidth="150.0" promptText="Ej: 10" styleClass="ps-input" />
        </VBox>
        <VBox spacing="6.0">
            <Label styleClass="ps-field-label" text="Tope de descuento (\$)" />
            <TextField fx:id="txtTope" prefWidth="190.0" promptText="Ej: 9000" styleClass="ps-input" />
        </VBox>
        <Label styleClass="ps-item-sub" text="Se aplican a las tarjetas que generes" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <HBox.margin><Insets bottom="12.0" /></HBox.margin>
        </Label>
        <Button fx:id="btnGenerarLote" minWidth="-Infinity" mnemonicParsing="false" onAction="#generarTarjetasMasivo" styleClass="ps-btn-outline, ps-btn-tall" text="Generar varias" />
        <Button fx:id="btnGenerar" minWidth="-Infinity" mnemonicParsing="false" onAction="#generarTarjetas" styleClass="ps-btn" text="Generar una">
            <graphic>
                <SVGPath content="M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z" scaleX="0.8" scaleY="0.8" styleClass="ps-icon" />
            </graphic>
        </Button>
    </HBox>

    <!-- Búsqueda y filtro -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <StackPane alignment="CENTER_LEFT" maxWidth="360.0" prefWidth="360.0" HBox.hgrow="ALWAYS">
            <TextField fx:id="txtCodigo" maxWidth="Infinity" onAction="#buscar" promptText="Buscar por código" styleClass="ps-input, ps-input-busqueda" />
            <SVGPath content="M10 2a8 8 0 0 1 6.32 12.9l5.39 5.4-1.41 1.41-5.4-5.39A8 8 0 1 1 10 2zm0 2a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" mouseTransparent="true" scaleX="0.75" scaleY="0.75" styleClass="ps-icon-muted">
                <StackPane.margin><Insets left="14.0" /></StackPane.margin>
            </SVGPath>
        </StackPane>
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="160.0" styleClass="ps-combo" />
        <Button fx:id="btnBuscar" minWidth="-Infinity" mnemonicParsing="false" onAction="#buscar" styleClass="ps-btn-dark, ps-btn-tall" text="Buscar" />
        <Button fx:id="btnLimpiarFiltro" minWidth="-Infinity" mnemonicParsing="false" onAction="#limpiarFiltro" styleClass="ps-btn-outline, ps-btn-tall" text="Limpiar" />
    </HBox>

    <!-- Tabla + panel de la tarjeta seleccionada -->
    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblTarjetas" styleClass="ps-table" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="220.0" text="Código de barra" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
                <TableColumn fx:id="colSellos" prefWidth="110.0" styleClass="ps-col-right" text="Sellos" />
                <TableColumn fx:id="colDescuento" prefWidth="120.0" styleClass="ps-col-right" text="Descuento" />
                <TableColumn fx:id="colTope" prefWidth="120.0" styleClass="ps-col-right" text="Tope" />
                <TableColumn fx:id="colFecha" prefWidth="180.0" styleClass="ps-col-muted" text="Activación" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder><Label styleClass="ps-placeholder" text="No hay tarjetas para mostrar" /></placeholder>
        </TableView>

        <VBox minWidth="340.0" prefWidth="380.0" spacing="14.0" styleClass="ps-detail-card">
            <Label maxWidth="Infinity" styleClass="ps-section-label" text="Tarjeta seleccionada" />

            <VBox spacing="4.0">
                <Label fx:id="lblCodigoSeleccionado" styleClass="ps-detail-title" text="---" wrapText="true" />
                <Label fx:id="lblEstado" styleClass="ps-detail-sub" text="Estado: ---" />
                <Label fx:id="lblFechaActivacion" styleClass="ps-detail-sub" text="Activación: ---" />
            </VBox>

            <VBox spacing="2.0" styleClass="ps-comp-totales">
                <Label styleClass="ps-stat-label" text="Sellos" />
                <Label fx:id="lblSellos" styleClass="ps-stock-grande" text="0 / 6" />
            </VBox>

            <HBox spacing="8.0">
                <Button fx:id="btnSumarSello" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#sumarSello" styleClass="ps-btn" text="+ Sello" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnQuitarSello" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#quitarSello" styleClass="ps-btn-outline, ps-btn-tall" text="− Sello" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button fx:id="btnReiniciar" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#reiniciarSellos" styleClass="ps-btn-outline, ps-btn-tall" text="Reiniciar sellos" />

            <Region VBox.vgrow="ALWAYS" />

            <Label maxWidth="Infinity" styleClass="ps-section-label" text="Estado de la tarjeta" />
            <HBox spacing="8.0">
                <Button fx:id="btnActivar" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#activarTarjeta" styleClass="ps-btn-dark, ps-btn-tall" text="Activar" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnDesactivar" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#desactivarTarjeta" styleClass="ps-btn-outline, ps-btn-tall" text="Desactivar" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button fx:id="btnEliminar" maxWidth="Infinity" minWidth="-Infinity" mnemonicParsing="false" onAction="#eliminarTarjeta" styleClass="ps-btn-outline-danger, ps-btn-tall" text="Eliminar tarjeta">
                <graphic>
                    <SVGPath content="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9zM7 6h10v13H7V6zm2 2v9h2V8H9zm4 0v9h2V8h-2z" scaleX="0.7" scaleY="0.7" styleClass="ps-icon" />
                </graphic>
            </Button>
        </VBox>
    </HBox>
</VBox>
